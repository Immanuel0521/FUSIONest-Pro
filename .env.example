# =================================================================
# FUSIONest Pro Environment Variables Template
# =================================================================
# Copy this file to `.env` and fill in your actual credentials.
# Never commit `.env` containing production secrets to public git.

# Supabase Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Publishable Key (safe for client-side use with RLS)
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Project ID (optional, used for local MCP tools)
VITE_SUPABASE_PROJECT_ID=your-project-id
